MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=7d
PORT=5000
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Optional (defaults shown)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_FROM=SkillLink <noreply@skilllink.app>
# CLIENT_URL=http://localhost:5173
# SESSION_TZ_OFFSET=+05:30   (timezone users enter session times in)
# ALLOWED_ORIGINS=https://skill-swap-6.vercel.app,http://localhost:5173   (sites allowed to call the API; falls back to CLIENT_URL)
